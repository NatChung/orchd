#!/usr/bin/env python3
"""Route one gh invocation without changing shared authentication state.

Accounts come from the JSON file named by ORCHD_GH_ACCOUNTS, else ~/.config/orchd/gh-accounts.json, e.g.
{"ExampleOwner": "ExampleOwner", "*": "ExampleOrg"}. Owners are case-insensitive. Omit '*' to let unmapped owners use
gh's original behavior with a warning. With neither file, gh runs unchanged and nothing is printed.
"""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
from urllib.parse import urlsplit


def warn(message):
    print(f"orchd gh: {message}; using original authentication", file=sys.stderr)


def real_gh():
    # Skip every copy of this wrapper, not just this file: a symlink to us, or orchd's installed copy next to the
    # packaged one, would otherwise call each other forever.
    me = Path(__file__).resolve()
    own = me.read_bytes()
    for directory in os.environ.get("PATH", os.defpath).split(os.pathsep):
        candidate = shutil.which("gh", path=directory or ".")
        if not candidate:
            continue
        path = Path(candidate).resolve()
        if os.environ.get("ORCHD_GH_WRAPPER_DIR") and path.parent == Path(os.environ["ORCHD_GH_WRAPPER_DIR"]).resolve():
            continue
        try:
            if path == me or path.read_bytes() == own:
                continue
        except OSError:
            pass
        return candidate
    return None


def owner(repo):
    if "://" in repo:
        repo = urlsplit(repo).path.lstrip("/")
    elif ":" in repo:
        repo = repo.split(":", 1)[1]
    parts = repo.strip("/").split("/")
    return parts[-2] if len(parts) >= 2 and parts[-2] else None


def target_owner(args, credential):
    if credential is not None:
        fields = dict(line.split("=", 1) for line in credential.decode(errors="replace").splitlines()
                      if "=" in line)
        # The credential request identifies the actual remote, even outside a clone.
        if fields.get("path"):
            return owner(fields["path"])
        if fields.get("url"):
            return owner(fields["url"])
    else:
        for i, arg in enumerate(args):
            if arg == "--":
                break
            if arg in ("--repo", "-R") and i + 1 < len(args):
                return owner(args[i + 1])
            if arg.startswith("--repo="):
                return owner(arg.split("=", 1)[1])
            if arg.startswith("-R") and len(arg) > 2:
                return owner(arg[2:])
        if os.environ.get("GH_REPO"):
            return owner(os.environ["GH_REPO"])
    result = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True, text=True)
    return owner(result.stdout.strip()) if result.returncode == 0 else None


GLOBAL_VALUE_FLAGS = ("-R", "--repo", "--hostname")  # change the target repo or host; take a value
GLOBAL_FLAGS = ("-h", "--help", "--version")


def classify(args):
    """Find the real gh subcommand. Returns (is_pr_create, normalized args, error). Global flags (-R, --repo,
    --hostname, with or without =) may precede the subcommand; any flag not listed here fails closed because we
    cannot tell whether it takes a value or retargets gh. `pr new` is gh's alias of `pr create`."""
    i = 0
    while i < len(args) and args[i].startswith("-"):
        name = args[i].split("=", 1)[0]
        if name in GLOBAL_VALUE_FLAGS:
            i += 1 if "=" in args[i] else 2
        elif name in GLOBAL_FLAGS:
            i += 1
        elif args[i].startswith("-R") and not args[i].startswith("--"):
            i += 1  # -Rowner/repo
        else:
            return False, args, f"unrecognized global flag {args[i]!r}; refusing it for a worker"
    rest = args[i:]
    if rest[:1] == ["pr"] and len(rest) > 1 and rest[1].startswith("-") and any(a in ("create", "new") for a in rest[2:]):
        return True, args, ("flags before the subcommand (e.g. gh pr -R x create) are not allowed for pr create: "
                            "they can retarget the repo")
    if rest[:1] == ["pr"] and rest[1:2] in (["create"], ["new"]):
        if i:
            return True, args, ("global flags before the subcommand (e.g. gh -R x pr create) are not allowed for "
                                "pr create: they can retarget the repo; orchd sets --repo itself")
        return True, ["pr", "create", *rest[2:]], None
    return False, args, None


def gate_pr_create(args):
    """A worker's `gh pr create` runs orchd's pinned delivery checks first; a refusal stops it, and gh then gets the
    arguments orchd returns (whitelisted flags, --head and --repo set from the task). A wrapper-level guard, not a
    security boundary: gh api (POST /pulls), git push, user-defined gh aliases and a direct gh binary bypass it;
    credential isolation is #121. Returns (exit code, args for gh)."""
    worktree = os.environ.get("ORCHD_WORKTREE")
    if not worktree:
        return 0, args
    create, normalized, error = classify(args)
    if not create and not error:
        return 0, args
    orchd = os.environ.get("ORCHD_BIN")
    if not orchd or not os.access(orchd, os.X_OK):
        print("orchd gh: cannot run the delivery checks (ORCHD_BIN missing or not executable); refusing gh pr create",
              file=sys.stderr)
        return 1, args
    # orchd decides whether this repo has a pipeline at all: if not, gh gets the original command unchanged.
    command = [orchd, "check", "gate", "--worktree", worktree] + (["--refuse", error] if error else [])
    result = subprocess.run([*command, "--", *(args if error else normalized)], stdout=subprocess.PIPE, text=True)
    if result.returncode:
        return result.returncode, args
    try:
        final = json.loads(result.stdout.strip().splitlines()[-1])
        if not isinstance(final, list) or not all(isinstance(a, str) for a in final):
            raise ValueError
    except (ValueError, IndexError):
        print("orchd gh: the delivery check returned no usable arguments; refusing gh pr create", file=sys.stderr)
        return 1, args
    return 0, final


def main():
    real = real_gh()
    if not real:
        print("orchd gh: no real gh executable found in PATH", file=sys.stderr)
        return 127
    args = sys.argv[1:]
    refused, args = gate_pr_create(args)
    if refused:
        return refused
    is_credential = args[:2] == ["auth", "git-credential"]
    # Auth inspection/management must retain gh semantics, including auth status.
    if "GH_TOKEN" in os.environ or (args[:1] == ["auth"] and not is_credential):
        if os.name == "nt":
            return subprocess.call([real, *args])
        os.execv(real, [real, *args])
    credential = sys.stdin.buffer.read() if is_credential else None
    env = dict(os.environ)
    config = Path(env.get("ORCHD_CONFIG_DIR") or Path.home() / ".config" / "orchd")
    source = env.get("ORCHD_GH_ACCOUNTS") or str(config / "gh-accounts.json")
    if env.get("ORCHD_GH_ACCOUNTS") or Path(source).is_file():  # no mapping configured: gh runs unchanged
        try:
            data = json.loads(Path(source).read_text())
            if not isinstance(data, dict) or not all(isinstance(k, str) and isinstance(v, str) and v
                                                     for k, v in data.items()):
                raise ValueError("expected an owner-to-account JSON object")
            accounts = {k.lower(): v for k, v in data.items()}
            target = target_owner(args, credential)
            account = accounts.get((target or "").lower(), accounts.get("*")) if target else None
            if target and not account:
                warn(f"no account mapping for owner {target}")
            elif account:
                token = subprocess.run([real, "auth", "token", "--hostname", "github.com", "-u", account],
                                       capture_output=True, text=True)
                if token.returncode == 0 and token.stdout.strip():
                    env["GH_TOKEN"] = token.stdout.strip()
                else:
                    warn(f"token unavailable for account {account}")
        except (OSError, ValueError) as error:
            warn(f"account routing unavailable ({type(error).__name__})")
    if credential is not None:
        # Replay stdin exactly; a regular temporary file avoids pipe-size deadlocks and lets us exec.
        import tempfile
        with tempfile.TemporaryFile() as replay:
            replay.write(credential)
            replay.seek(0)
            if os.name == "nt":
                return subprocess.call([real, *args], stdin=replay, env=env)
            os.dup2(replay.fileno(), 0)
            os.execve(real, [real, *args], env)
    if os.name == "nt":
        return subprocess.call([real, *args], env=env)
    os.execve(real, [real, *args], env)


if __name__ == "__main__":
    sys.exit(main())
